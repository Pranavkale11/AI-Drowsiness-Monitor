# ============================================================
# .env.example — DrowseGuard AI | SOS Emergency Alert System
# ============================================================
# Copy this file to ".env" and fill in your real credentials.
#
#   cp .env.example .env
#
# The .env file is listed in .gitignore and must NEVER be committed
# to version control.  Keep your Auth Token secret at all times.
# ============================================================

# ── Twilio Credentials ──────────────────────────────────────
# Find these in: https://console.twilio.com/ → Account Info

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your Twilio phone number (SMS-capable, in E.164 format)
# Example: +12025551234
TWILIO_PHONE_NUMBER=

# ── Emergency Contact ────────────────────────────────────────
# The mobile number that will receive SOS alert SMS messages.
# Must be in E.164 format: +<country_code><number>
# Example India: +919876543210
# Example US:    +12025551234
#
# IMPORTANT (Twilio Trial Accounts):
#   Trial accounts can only send SMS to Verified Caller IDs.
#   Verify this number at:
#   https://console.twilio.com/us1/develop/phone-numbers/verified-caller-ids
#
# This value can also be set (and overridden) from the sidebar UI.
EMERGENCY_PHONE_NUMBER=
